# ══════════════════════════════════════════════════════════════════════════
# API ENVIRONMENT TEMPLATE (Savitura/Savitools#197)
# ══════════════════════════════════════════════════════════════════════════
# Every variable below is read by apps/api at runtime. Startup validation
# (src/config/env-validation.ts) enforces required URLs, production HTTPS,
# and non-placeholder secrets — see the notes on each entry.
# ══════════════════════════════════════════════════════════════════════════

# ─── API ───────────────────────────────────────────────────────────────────────
# The environment the app runs in (development, production, test)
NODE_ENV=development
# The port the API listens on
API_PORT=3001
# The prefix for all API routes
API_PREFIX=api

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Format: postgresql://[user]:[password]@[host]:[port]/[db]
# REQUIRED — the API fails to start without it.
DATABASE_URL=postgresql://postgres:password@localhost:5432/savitools
# Set to true in deployments that should apply pending TypeORM migrations on startup.
RUN_MIGRATIONS=false

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection string. Format: redis://[host]:[port]. Required.
REDIS_URL=redis://localhost:6379

# ─── Auth secrets ──────────────────────────────────────────────────────────────
# Secret used for JWT token generation. REQUIRED in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Master secret used to derive per-user AES-256 keys (HKDF) for vault keys and
# connected accounts. REQUIRED in production — losing it makes stored secrets
# unrecoverable. Generate with: openssl rand -base64 48
# Must be at least 32 characters in production.
ENCRYPTION_SECRET=
# The origin of the web frontend, used for CORS
WEB_ORIGIN=http://localhost:3000

# ─── Stellar ───────────────────────────────────────────────────────────────────
# Stellar network to use (testnet or public)
STELLAR_NETWORK=testnet
# Horizon API URL. Get from Stellar docs or run your own.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Soroban RPC URL. Get from Stellar docs.
STELLAR_RPC_URL=https://soroban-rpc-testnet.stellar.org
# Optional public-network overrides used by the monitor.
STELLAR_HORIZON_MAINNET_URL=https://horizon.stellar.org
STELLAR_RPC_PUBLIC_URL=https://mainnet.sorobanrpc.com
# Stellar network passphrase. Must match the network above. Optional — the
# ContractsService falls back to the well-known passphrase for the network.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ─── Contracts / Deployer ─────────────────────────────────────────────────────
# Secret key used to deploy contracts. Needs to be funded on the target network.
# REQUIRED: ContractsService reads it with getOrThrow during startup, so the
# API cannot boot without a valid 56-character secret key (starting with S).
DEPLOYER_SECRET_KEY=
# Comma-separated emails allowed to call the deploy/invoke contract endpoints.
# Empty (default) denies everyone.
CONTRACT_ADMIN_EMAILS=
# Comma-separated contract IDs the invoke endpoint is allowed to call.
# Empty (default) denies everyone.
CONTRACT_INVOKE_ALLOWED_CONTRACTS=
# Comma-separated function names the invoke endpoint is allowed to call.
# Empty (default) denies everyone.
CONTRACT_INVOKE_ALLOWED_FUNCTIONS=
# Maximum uploaded WASM size in bytes (default 5 MiB).
MAX_WASM_FILE_SIZE=
# Comma-separated Git hosts allowed for WASM imports. Defaults to github.com,gitlab.com.
WASM_GIT_ALLOWED_HOSTS=github.com,gitlab.com
# Timeout in milliseconds when cloning a Git repo for WASM imports.
GIT_CLONE_TIMEOUT_MS=30000
# Timeout in milliseconds when fetching WASM from a URL.
WASM_URL_TIMEOUT_MS=

# ─── Webhooks ──────────────────────────────────────────────────────────────────
# Secret used to sign outbound webhook payloads: HMAC-SHA256 over the UTF-8 bytes
# of `<timestamp>.<body>`, sent as X-SaviTools-Signature + X-SaviTools-Timestamp.
# Optional — outbound webhooks are sent unsigned when unset, unless the request
# supplies its own per-request `secret`. See GET /webhooks/signing.
WEBHOOK_SIGNING_SECRET=

# ─── Monitor notifications ────────────────────────────────────────────────────
# Role for this process: 'all' (default), 'api' (HTTP only, producers disabled),
# or 'worker' (dedicated queue/evaluation worker, no HTTP).
MONITOR_ROLE=all
# Email delivery (Resend). Optional; when RESEND_API_KEY is set,
# RESEND_FROM_EMAIL is also required.
RESEND_API_KEY=
RESEND_FROM_EMAIL="SaviTools <alerts@savitools.dev>"
# How often balance and transaction-count alert rules are checked against
# Horizon, in milliseconds. Set to 0 to disable these checks.
MONITOR_EVALUATION_INTERVAL_MS=60000
# How often the leader checks for pending notifications in PostgreSQL to re-enqueue.
MONITOR_DISPATCH_INTERVAL_MS=30000
# Redis lease TTL for monitor leader election in milliseconds (minimum 1000).
MONITOR_LEADER_LEASE_MS=30000
# Maximum simultaneous SSE clients (default 50).
MAX_SSE_CONNECTIONS=50

# ─── Metrics ───────────────────────────────────────────────────────────────────
# Optional bearer key protecting /metrics endpoints. When
# METRICS_INTERNAL_ONLY=true (the default when unset), metrics are restricted to
# loopback/private ranges instead. Only the exact string "false" disables the
# restriction, so leave this absent or true unless an upstream firewall,
# sidecar, or ingress policy already restricts access. See docs/metrics.md.
METRICS_API_KEY=
METRICS_INTERNAL_ONLY=true

# Federation / stellar.toml remote request and cache limits (milliseconds / entries).
# Invalid or non-positive values fall back to the defaults shown here.
FEDERATION_PROBE_TIMEOUT_MS=3000
FEDERATION_REQUEST_TIMEOUT_MS=5000
FEDERATION_TOML_CACHE_TTL_MS=300000
FEDERATION_TOML_CACHE_MAX_ENTRIES=200

# ─── Fluxa OAuth (optional) ────────────────────────────────────────────────────
# OAuth, metrics, and contract allowlist variables (Savitura/Savitools#197).
# Optional in development (mock tenant IDs are used when unset).
# If FLUXA_CLIENT_ID is set, FLUXA_CLIENT_SECRET and FLUXA_AUTH_URL are required.
FLUXA_API_URL=https://api.fluxa.io
FLUXA_AUTH_URL=
FLUXA_TOKEN_URL=
FLUXA_CLIENT_ID=
FLUXA_CLIENT_SECRET=
# Defaults to ${WEB_ORIGIN}/auth/fluxa when unset.
FLUXA_CALLBACK_URL=

# ─── Playground ─────────────────────────────────────────────────────────────────
# API URL for CrowdPay services
CROWDPAY_API_URL=https://api.crowdpay.io
# Time-to-live for playground specs in milliseconds (e.g., 3600000 for 1 hour)
PLAYGROUND_SPEC_TTL_MS=3600000

# ─── SDK Generation (optional, used by sdkgen when generating from URLs) ───────
ARWEAVE_GATEWAY_URL=https://arweave.net
IPFS_GATEWAY_URL=https://ipfs.io
